<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="true"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/screens_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/screen_vertical_margin"
            android:paddingEnd="@dimen/screen_horizontal_margin"
            android:paddingBottom="@dimen/screen_vertical_margin">

        <include
            android:id="@+id/welcome_group"
            layout="@layout/view_welcome" />

        <include
            android:id="@+id/home_group"
            layout="@layout/view_home" />

        <include
            android:id="@+id/settings_group"
            layout="@layout/view_settings" />

        <LinearLayout
            android:id="@+id/connect_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityPaneTitle="@string/connect_storage_box"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/connect_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@string/connect_storage_box"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/connect_explanation"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/username_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/storage_box_username">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/username_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:maxLength="64"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/storage_box_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:importantForAutofill="noExcludeDescendants"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:maxLength="1024"
                    android:saveEnabled="false"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/advanced_hostname_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/use_different_server" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hostname_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/server_address"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hostname_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLength="253"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ssh_port_explanation"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="@string/connect_and_continue" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/connect_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/connect_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/connect_error"
                style="@style/PiffBackup.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_console_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/open_hetzner_console"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/destination_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityPaneTitle="@string/choose_storage_box_folder"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/destination_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                app:navigationContentDescription="@string/back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@string/choose_storage_box_folder"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:id="@+id/destination_connection_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/choose_storage_box_folder_help"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/destination_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/destination_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/destination_directory_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/backup_folder_dropdown_hint">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/destination_directory_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_destination_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:minHeight="52dp"
                android:text="@string/continue_action" />

            <TextView
                android:id="@+id/destination_error"
                style="@style/PiffBackup.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_destination_list_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/retry_folder_list"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_destination_connection_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="@string/change_connection" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/adoption_mapping_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityPaneTitle="@string/choose_backup_folders"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/folders_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationContentDescription="@string/back"
                app:title="@string/folders"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:id="@+id/folders_connection_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <include
                android:id="@+id/storage_access_panel"
                layout="@layout/view_storage_access" />

            <TextView
                android:id="@+id/configured_mappings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:id="@+id/configured_mapping_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapping_details_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/folder_setup_details"
                app:icon="@drawable/ic_expand_more"
                app:iconGravity="textEnd"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/mapping_details_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/all_files_access_explanation"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_mappings_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/clear_selected_folders"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/adoption_error"
                style="@style/PiffBackup.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/adoption_discovery_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_local_folder_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/add_local_folder"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preview_adoption_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/check_existing_backup" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mapping_editor_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityPaneTitle="@string/add_local_folder"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/mapping_editor_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationContentDescription="@string/back"
                app:title="@string/add_local_folder"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                style="@style/PiffBackup.SectionLabel"
                android:layout_marginTop="16dp"
                android:text="@string/phone_folder" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/selected_local_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/PiffBackup.SectionLabel"
                android:layout_marginTop="28dp"
                android:text="@string/storage_box_destination" />

            <TextView
                android:id="@+id/remote_browser_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <TextView
                android:id="@+id/remote_browser_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_remote_list_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/retry_folder_list"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/remote_directory_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/open_remote_subfolder">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/remote_directory_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/remote_up_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:minHeight="48dp"
                    android:text="@string/remote_folder_up_compact" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/use_remote_folder_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:minHeight="48dp"
                    android:text="@string/use_current_folder" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/new_remote_folder_toggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/create_remote_folder_option"
                app:icon="@drawable/ic_expand_more"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:id="@+id/new_remote_folder_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/new_remote_folder_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/new_remote_folder_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/new_remote_folder_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="120"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/use_new_remote_folder_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/use_new_remote_folder_compact" />
            </LinearLayout>

            <com.google.android.material.chip.Chip
                android:id="@+id/selected_remote_folder"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                style="@style/PiffBackup.SectionLabel"
                android:layout_marginTop="28dp"
                android:text="@string/files_included" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/mapping_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/media_fast_mode"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:minHeight="48dp"
                    android:text="@string/media_only_compact" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/all_files_mode"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/all_files_compact" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapping_mode_help_toggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/which_backup_mode"
                app:icon="@drawable/ic_expand_more"
                app:iconGravity="textEnd" />

            <TextView
                android:id="@+id/mapping_mode_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_mode_help"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mapping_editor_error"
                style="@style/PiffBackup.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_mapping_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="52dp"
                android:text="@string/add_this_mapping" />
        </LinearLayout>

        <include
            android:id="@+id/adoption_flow"
            layout="@layout/view_adoption_flow" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
